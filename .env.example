# Replace placeholders in your local .env. Never commit real credentials or signing keys.
DB_HOST=your-postgresql-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-database-password
SERVER_PORT=8080
DRAS_FAILURE_INJECTION=false
# Generate with: openssl rand -base64 32. Set a unique value outside local development.
DRAS_JWT_SECRET=replace-with-generated-base64-secret
DRAS_ACCESS_TOKEN_SECONDS=900
DRAS_REFRESH_TOKEN_DAYS=14
# Production enforces this to true; this value is for local configuration only.
DRAS_AUTH_COOKIE_SECURE=false
# Optional secure path for the one-time generated initial account credentials file.
DRAS_INITIAL_CREDENTIALS_FILE=replace-with-secure-credentials-file-path
